{
  "name": "retypeset-odyssey",
  "type": "module",
  "version": "0.1.24",
  "description": "Trilingual (zh/en/ja) Astro blog theme, usable as a standalone template or an installable npm package for content-only repos. Forked from astro-theme-retypeset; adds npm packaging, folder-based collections, Hexo migration, and agent-facing docs (AI_USAGE.md, a Claude Skill, and build-time llms.txt).",
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "theme",
    "i18n",
    "typography",
    "retypeset",
    "llms-txt",
    "agent-skill",
    "ai-friendly"
  ],
  "packageManager": "pnpm@10.26.0",
  "repository": "https://github.com/lifeodyssey/retypeset-odyssey",
  "exports": {
    ".": "./integration.ts",
    "./integration": "./integration.ts",
    "./config": "./src/config.ts",
    "./content-config": "./src/content.config.ts",
    "./astro.config": "./astro.config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "public",
    "patches",
    "scripts",
    "integration.ts",
    "static-assets.ts",
    "discover-collections.ts",
    "astro.config.ts",
    "tsconfig.json",
    "uno.config.ts",
    "default-config.yaml",
    "skill",
    "AI_USAGE.md"
  ],
  "scripts": {
    "dev": "astro check && astro dev",
    "build": "pnpm generate-legacy-redirects && astro check && astro build && pnpm apply-lqip",
    "preview": "astro preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "new-post": "tsx scripts/new-post.ts",
    "translate:new-posts": "node scripts/translation/run.mjs",
    "generate-legacy-redirects": "tsx scripts/seo/generate-legacy-redirects.ts",
    "apply-lqip": "tsx scripts/apply-lqip.ts",
    "format-posts": "tsx scripts/format-posts.ts",
    "update-theme": "tsx scripts/update-theme.ts",
    "test:static-assets": "tsx --test tests/static-assets.node.ts",
    "test:config-schema": "tsx --test tests/config-schema.node.ts",
    "test:prefetch": "tsx --test tests/prefetch.node.ts",
    "test:footer-output": "tsx --test tests/footer-output.node.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "@unocss/astro": "66.7.0",
    "@unocss/reset": "66.7.0",
    "@waline/client": "^3.16.0",
    "astro": "^7.3.7",
    "astro-compress": "^2.4.3",
    "astro-og-canvas": "^0.13.2",
    "astro-pagefind": "^2.0.1",
    "canvaskit-wasm": "^0.41.1",
    "feed": "^5.2.1",
    "katex": "0.18.10",
    "lite-youtube-embed": "^0.3.4",
    "markdown-it": "^14.3.2",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "node-html-parser": "^7.1.0",
    "playwright": "^1.64.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.0",
    "sharp": "0.35.5",
    "sirv": "^3.0.2",
    "twikoo": "^1.7.24",
    "unist-util-visit": "^5.1.0",
    "unocss": "66.7.0",
    "unocss-preset-theme": "^0.14.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@playwright/test": "^1.64.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.9",
    "@types/sanitize-html": "^2.16.2",
    "@unocss/eslint-plugin": "66.7.0",
    "@unocss/preset-attributify": "66.7.0",
    "astro-eslint-parser": "^1.4.0",
    "autocorrect-node": "^2.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "fast-glob": "^3.3.3",
    "lint-staged": "^17.6.0",
    "opentype.js": "^2.0.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "svgo": "4.1.0",
      "sharp": "0.35.5",
      "katex": "0.18.10"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": "eslint --fix"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
